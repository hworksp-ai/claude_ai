# Streamlit Cloud 배포 시 사용하는 시크릿 설정 파일
# 실제 secrets.toml 은 .gitignore 에 포함되어 Git 에 올라가지 않습니다.
# Streamlit Cloud → 앱 설정 → Secrets 메뉴에 아래 내용을 붙여넣으세요.
# (로컬에서 실행할 때는 이 파일을 복사해 .streamlit/secrets.toml 로 저장하거나,
#  WIG_APP_PASSWORD 환경변수로 대신 지정해도 됩니다.)

APP_PASSWORD = "여기에_원하는_비밀번호_입력"

# 재배포/재시작에도 데이터가 유지되도록 외부 Postgres DB를 쓰려면 아래를 설정하세요.
# (Supabase, Neon, Railway 등에서 무료로 발급받은 연결 문자열을 붙여넣으면 됩니다)
# 설정하지 않으면 앱이 자동으로 로컬 SQLite 파일을 사용합니다 (재배포 시 초기화됨).
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
